[Unit]
Description=LifeOS private web application
Requires=lifeos-init.service
After=lifeos-init.service lifeos-api.service
PartOf=lifeos.target

[Service]
User=lifeos
Group=lifeos
WorkingDirectory=/opt/lifeos/apps/web
EnvironmentFile=/etc/lifeos/runtime.env
ExecStart=/usr/bin/node /opt/lifeos/apps/web/scripts/start.mjs --hostname 127.0.0.1 --port ${LIFEOS_WEB_PORT}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
