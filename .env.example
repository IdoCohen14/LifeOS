# Optional process environment overrides; scripts/run.py reads the process environment.
# This file is documentation, not automatically loaded. Never put secrets in NEXT_PUBLIC_*.
# Defaults to %LOCALAPPDATA%/LifeOS on Windows, outside this OneDrive repository.
# Linux/macOS: $XDG_DATA_HOME/lifeos or ~/.local/share/lifeos.
# PowerShell example: $env:LIFEOS_DATA_DIR="$env:LOCALAPPDATA\LifeOS"
LIFEOS_DATA_DIR=
# Optional validated launcher arguments: --web-port 3100 --api-port 8876 --build-dir .next-phase-b
# These set server-only LIFEOS_WEB_PORT, LIFEOS_API_PORT and LIFEOS_BUILD_DIR for child processes.
# LIFEOS_TEST_BASE_URL selects a separate Playwright target; never use personal data for fixtures.
# LIFEOS_API_KEY is generated for each launch; do not set a public/browser key.
# LIFEOS_SETUP_PASSWORD is intended only for isolated automated test data, never committed.

# Optional isolated local account mode (or scripts/run.py --account-mode).
LIFEOS_ACCOUNT_MODE=0
# Server-only Google application keys; never NEXT_PUBLIC_*. No user tokens are shared.
LIFEOS_GOOGLE_CLIENT_ID=
LIFEOS_GOOGLE_CLIENT_SECRET=
# Account callback: http://127.0.0.1:<web-port>/api/accounts/oauth/callback

# Local is the default. Server preparation: deploy/linux/README_HE.md.
# Server mode requires an explicit HTTPS origin and absolute private data directory.
# It forces account mode, Secure cookies and disables model inference.
LIFEOS_DEPLOYMENT_MODE=local
# LIFEOS_PUBLIC_ORIGIN=https://your-approved-host.example
# Optional closed pilot, server mode only. Generate with server_manage.py init --pilot.
# Provision the configured owner offline before starting; registration remains closed.
# LIFEOS_PILOT_OWNER_ID=<canonical-uuid>
